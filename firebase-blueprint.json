{
  "entities": {
    "site_settings": {
      "title": "Site Settings",
      "description": "Global portfolio configuration, profile details, CV link, and biography",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "fullName": { "type": "string" },
        "creativeName": { "type": "string" },
        "title": { "type": "string" },
        "bio": { "type": "string" },
        "aboutBio": { "type": "string" },
        "statusText": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "profileImage": { "type": "string" },
        "cvUrl": { "type": "string" },
        "email": { "type": "string" },
        "location": { "type": "string" },
        "skills": { "type": "array" },
        "timeline": { "type": "array" },
        "services": { "type": "array" },
        "testimonials": { "type": "array" },
        "socialLinks": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    },
    "settings": {
      "title": "CV & Structured Settings",
      "description": "Dedicated CV document configuration",
      "type": "object",
      "properties": {
        "sourceType": { "type": "string" },
        "fileType": { "type": "string" },
        "fileName": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "published": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      }
    },
    "projects": {
      "title": "Projects",
      "description": "Portfolio projects showcase",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "detailedDescription": { "type": "string" },
        "image": { "type": "string" },
        "tags": { "type": "array" },
        "githubUrl": { "type": "string" },
        "liveUrl": { "type": "string" },
        "featured": { "type": "boolean" },
        "visibility": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "category", "description"]
    },
    "contact_messages": {
      "title": "Contact Messages",
      "description": "Inbound contact submissions from the portfolio portal",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "service": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["name", "email", "message"]
    },
    "articles": {
      "title": "Articles & Writing",
      "description": "Published editorial articles, essays, and design case breakdowns",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "category": { "type": "string" },
        "coverImage": { "type": "string" },
        "publishedAt": { "type": "string" },
        "readTime": { "type": "string" },
        "published": { "type": "boolean" },
        "tags": { "type": "array" }
      },
      "required": ["title", "slug", "content"]
    },
    "media": {
      "title": "Media Items",
      "description": "Uploaded media files and assets",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "size": { "type": "string" },
        "type": { "type": "string" },
        "uploadedAt": { "type": "string" }
      },
      "required": ["name", "url"]
    },
    "analytics": {
      "title": "Analytics and Page Views",
      "description": "Daily page view counts and activity metric trends",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "views": { "type": "number" },
        "inquiries": { "type": "number" },
        "updatedAt": { "type": "string" }
      }
    },
    "admins": {
      "title": "Authorized Administrators",
      "description": "Role-based access records for verified administrators",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "editor"] },
        "status": { "type": "string", "enum": ["active", "revoked"] }
      },
      "required": ["email", "role", "status"]
    }
  },
  "firestore": {
    "/site_settings/{document}": {
      "schema": "site_settings",
      "description": "Global portfolio configuration, profile details, CV link, and biography"
    },
    "/settings/{document}": {
      "schema": "settings",
      "description": "Structured CV configuration document"
    },
    "/projects/{projectId}": {
      "schema": "projects",
      "description": "Portfolio projects showcase catalog"
    },
    "/articles/{articleId}": {
      "schema": "articles",
      "description": "Published articles and essays"
    },
    "/media/{mediaId}": {
      "schema": "media",
      "description": "Uploaded media assets catalogue"
    },
    "/contact_messages/{messageId}": {
      "schema": "contact_messages",
      "description": "Inbound contact form messages (PII restricted to admins)"
    },
    "/analytics/{docId}": {
      "schema": "analytics",
      "description": "Page view statistics and contact form activity trends"
    },
    "/admins/{uid}": {
      "schema": "admins",
      "description": "Authorized admin roles allowlist"
    }
  }
}
