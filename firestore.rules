rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Site Settings: Public read, full admin CMS updates
    match /site_settings/{document} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // Settings (including settings/cv for active CV configuration): Public read, CMS updates
    match /settings/{document} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Portfolio Projects: Public catalog read, full CMS management
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update: if isValidId(projectId) && (
        request.resource.data.title is string && request.resource.data.title.size() > 0
      );
      allow delete: if true;
    }

    // Editorial Articles: Public reading, full CMS management
    match /articles/{articleId} {
      allow get, list: if true;
      allow create, update: if isValidId(articleId) && (
        request.resource.data.title is string && request.resource.data.title.size() > 0
      );
      allow delete: if true;
    }

    // Media Library: Public asset access, full catalog management
    match /media/{mediaId} {
      allow get, list: if true;
      allow create, update: if isValidId(mediaId);
      allow delete: if true;
    }

    // Inbound Contact Messages
    match /contact_messages/{messageId} {
      allow create: if isValidId(messageId)
        && isValidString(request.resource.data.name, 1, 200)
        && isValidString(request.resource.data.email, 3, 300)
        && isValidString(request.resource.data.message, 1, 10000);
      allow get, list, update, delete: if true;
    }

    match /messages/{messageId} {
      allow create: if isValidId(messageId);
      allow get, list, update, delete: if true;
    }

    // Analytics Telemetry
    match /analytics/{docId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Lockdown unspecified paths
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
