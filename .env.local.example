# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Service Account (Server-Side Only)
FIREBASE_SERVICE_ACCOUNT_KEY=your_service_account_json_base64_encoded

# Email Configuration
NEXT_PUBLIC_CONTACT_EMAIL=your_email@example.com
EMAIL_API_KEY=your_email_api_key

# PDF Configuration
NEXT_PUBLIC_PDF_URL=https://firebasestorage.googleapis.com/v0/b/your-bucket/o/cv.pdf

# Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
